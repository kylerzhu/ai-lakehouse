# 组件版本（T01 核对于 2026-11-19）
# 修改任何版本前，先确认 Paimon 文档中的兼容矩阵，再运行 scripts/check_jars.sh 验证下载地址。

# ---- Docker 镜像（均有 arm64 版本）
FLINK_IMAGE=flink:1.20.5-scala_2.12-java17
SPARK_IMAGE=apache/spark:3.5.9-scala2.12-java17-python3-ubuntu
KAFKA_IMAGE=apache/kafka:4.3.2
POSTGRES_IMAGE=postgres:16.15

# ---- Flink 插件 jar（放入 /opt/flink/lib）
FLINK_VERSION=1.20.5
PAIMON_VERSION=1.4.2
FLINK_KAFKA_CONNECTOR_VERSION=3.4.0-1.20
FLINK_JDBC_CONNECTOR_VERSION=3.3.0-1.20
POSTGRES_JDBC_VERSION=42.7.14
FLINK_SHADED_HADOOP_VERSION=2.8.3-10.0

# ---- Spark 插件 jar（放入 /opt/spark/jars）
SPARK_VERSION=3.5.9
SCALA_BINARY_VERSION=2.12
