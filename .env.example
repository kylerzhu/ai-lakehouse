# 复制为 .env 后填写（`make env` 会自动复制并生成随机密码）。.env 不入库。

# ---- PostgreSQL（宿主机端口 5433）
POSTGRES_USER=llmobs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llmobs

# ---- 模型 API（OpenAI 兼容；只有 Agent 和评测需要，Phase 4 再填）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Kafka（宿主机访问地址）
KAFKA_BOOTSTRAP=localhost:9094
